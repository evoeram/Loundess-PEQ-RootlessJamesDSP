<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup
        android:disableDependentsState="false"
        android:key="@string/key_cure_enable"
        android:title="@string/cure_enable"
        android:summary="@string/cure_summary"
        android:icon="@drawable/ic_twotone_headphones_24dp"
        app:iconSpaceReserved="false">
        <ListPreference
            android:key="@string/key_cure_level"
            android:title="@string/cure_level"
            android:defaultValue="0"
            android:entries="@array/cure_levels"
            android:entryValues="@array/cure_levels_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false"/>
    </me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup>

</PreferenceScreen>
