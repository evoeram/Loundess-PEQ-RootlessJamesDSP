<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup
        android:disableDependentsState="false"
        android:key="@string/key_dynamiceq_enable"
        android:title="@string/dyneq_title"
        android:summary="@string/dyneq_summary"
        android:icon="@drawable/ic_baseline_equalizer_24dp"
        app:iconSpaceReserved="false">
        <Preference
            android:key="@string/key_dynamiceq_bands"
            android:title="@string/dyneq_bands"
            android:summary="@string/dyneq_bands_summary"
            app:iconSpaceReserved="false" />
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_dynamiceq_mix"
            android:title="@string/dyneq_mix"
            android:defaultValue="100"
            app:minValue="0"
            app:maxValue="100"
            app:unit="%"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            android:key="@string/key_dynamiceq_msmode"
            android:title="@string/dyneq_ms_mode"
            android:defaultValue="0"
            android:entries="@array/dyneq_ms_modes"
            android:entryValues="@array/dyneq_ms_modes_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
    </me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup>
</PreferenceScreen>
