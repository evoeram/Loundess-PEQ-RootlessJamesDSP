<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup
        android:disableDependentsState="false"
        android:key="@string/key_agc_enable"
        android:title="@string/agc_enable"
        android:summary="@string/agc_summary"
        android:icon="@drawable/ic_baseline_chart_timeline_variant_24dp"
        app:iconSpaceReserved="false">
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_agc_target"
            android:title="@string/agc_target"
            android:defaultValue="30"
            app:minValue="10"
            app:maxValue="80"
            app:seekBarIncrement="1"
            app:unit="%"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_agc_maxboost"
            android:title="@string/agc_maxboost"
            android:defaultValue="120"
            app:minValue="0"
            app:maxValue="200"
            app:seekBarIncrement="5"
            app:unit=""
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
    </me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup>

</PreferenceScreen>
