<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup
        android:disableDependentsState="false"
        android:key="@string/key_tape_enable"
        android:title="@string/tape_enable"
        android:summary="@string/tape_summary"
        android:icon="@drawable/ic_baseline_sine_wave_24dp"
        app:iconSpaceReserved="false">
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_tape_wow"
            android:title="@string/tape_wow"
            android:defaultValue="25"
            app:minValue="0"
            app:maxValue="100"
            app:seekBarIncrement="1"
            app:unit="%"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_tape_flutter"
            android:title="@string/tape_flutter"
            android:defaultValue="30"
            app:minValue="0"
            app:maxValue="100"
            app:seekBarIncrement="1"
            app:unit="%"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_tape_saturation"
            android:title="@string/tape_saturation"
            android:defaultValue="35"
            app:minValue="0"
            app:maxValue="100"
            app:seekBarIncrement="1"
            app:unit="%"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_tape_bias"
            android:title="@string/tape_bias"
            android:summary="@string/tape_bias_summary"
            android:defaultValue="-20"
            app:minValue="-100"
            app:maxValue="100"
            app:seekBarIncrement="1"
            app:unit="%"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_tape_headbump"
            android:title="@string/tape_headbump"
            android:defaultValue="30"
            app:minValue="0"
            app:maxValue="90"
            app:seekBarIncrement="1"
            app:unit="dB"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_tape_mix"
            android:title="@string/tape_mix"
            android:defaultValue="100"
            app:minValue="0"
            app:maxValue="100"
            app:seekBarIncrement="1"
            app:unit="%"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
    </me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup>

</PreferenceScreen>
