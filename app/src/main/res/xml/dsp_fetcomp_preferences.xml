<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup
        android:disableDependentsState="false"
        android:key="@string/key_fetcomp_enable"
        android:title="@string/fetcomp_enable"
        android:summary="@string/fetcomp_summary"
        android:icon="@drawable/ic_baseline_waveform_24dp"
        app:iconSpaceReserved="false">
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_fetcomp_threshold"
            android:title="@string/fetcomp_threshold"
            android:defaultValue="-180"
            app:minValue="-600"
            app:maxValue="0"
            app:seekBarIncrement="5"
            app:unit=""
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_fetcomp_ratio"
            android:title="@string/fetcomp_ratio"
            android:defaultValue="40"
            app:minValue="10"
            app:maxValue="200"
            app:seekBarIncrement="5"
            app:unit=""
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_fetcomp_attack"
            android:title="@string/fetcomp_attack"
            android:defaultValue="50"
            app:minValue="1"
            app:maxValue="1000"
            app:seekBarIncrement="1"
            app:unit=""
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_fetcomp_release"
            android:title="@string/fetcomp_release"
            android:defaultValue="1200"
            app:minValue="100"
            app:maxValue="10000"
            app:seekBarIncrement="10"
            app:unit=""
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_fetcomp_makeup"
            android:title="@string/fetcomp_makeup"
            android:defaultValue="0"
            app:minValue="0"
            app:maxValue="24"
            app:seekBarIncrement="1"
            app:unit="dB"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
    </me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup>

</PreferenceScreen>
