<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet для интерактивной настройки полос параметрического эквалайзера.
     Содержит превью АЧХ, чипы выбора полосы и слайдеры частоты/усиления/Q. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Drag handle -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/shape_rounded_rectangle"
        android:backgroundTint="?attr/colorOnSurfaceVariant" />

    <!-- Заголовок + кнопки Add/Delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/peq_live_eq"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addBandButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="@string/peq_live_eq_add"
            android:enabled="false"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_baseline_add_24dp"
            app:iconGravity="textStart"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteBandButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="@string/peq_live_eq_delete"
            android:enabled="false"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_twotone_delete_24dp"
            app:iconGravity="textStart"
            app:iconSize="16dp" />
    </LinearLayout>

    <!-- Превью АЧХ — максимально большой -->
    <me.timschneeberger.rootlessjamesdsp.view.ParametricEqSurface
        android:id="@+id/liveEqSurface"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Чипы выбора полосы -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/bandChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            app:singleLine="true"
            app:selectionRequired="false"
            app:singleSelection="true" />

    </HorizontalScrollView>

    <!-- Подсказка «нажмите на полосу» — показывается пока полоса не выбрана -->
    <TextView
        android:id="@+id/liveEqHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:text="@string/peq_live_eq_hint"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- Секция слайдеров — скрыта пока полоса не выбрана -->
    <LinearLayout
        android:id="@+id/slidersSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:visibility="gone">

        <!-- Frequency: label + точный ввод + слайдер -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/peq_frequency"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/freqInput"
                android:layout_width="88dp"
                android:layout_height="36dp"
                android:inputType="numberDecimal"
                android:imeOptions="actionDone"
                android:textSize="13sp"
                android:gravity="center"
                android:hint="Hz" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/freqSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="0"
            app:labelBehavior="floating" />

        <!-- Gain: label + точный ввод + слайдер -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/peq_gain"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/gainInput"
                android:layout_width="88dp"
                android:layout_height="36dp"
                android:inputType="numberDecimal|numberSigned"
                android:imeOptions="actionDone"
                android:textSize="13sp"
                android:gravity="center"
                android:hint="dB" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/gainSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="-30"
            android:valueTo="30"
            android:stepSize="0"
            app:labelBehavior="floating" />

        <!-- Q: label + точный ввод + слайдер -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/peq_q_factor"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/qInput"
                android:layout_width="88dp"
                android:layout_height="36dp"
                android:inputType="numberDecimal"
                android:imeOptions="actionDone"
                android:textSize="13sp"
                android:gravity="center"
                android:hint="Q" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/qSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="0"
            app:labelBehavior="floating" />

        <!-- Preamp: label + точный ввод + слайдер -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/peq_preamp"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/preampInput"
                android:layout_width="88dp"
                android:layout_height="36dp"
                android:inputType="numberDecimal|numberSigned"
                android:imeOptions="actionDone"
                android:textSize="13sp"
                android:gravity="center"
                android:hint="dB" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/preampSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="-30"
            android:valueTo="30"
            android:stepSize="0"
            app:labelBehavior="floating" />

        <!-- Auto Preamp checkbox: auto-set preamp = -max(positive gain) -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/autoPreampSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/squig_live_eq_auto_preamp"
            android:checked="false" />

        <!-- Переключатель канала: L / L+R / R -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/peq_channel_mode"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/channelChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/channelLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/peq_channel_left"
                android:checkable="true"
                style="@style/Widget.Material3.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/channelBoth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/peq_channel_both"
                android:checkable="true"
                style="@style/Widget.Material3.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/channelRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/peq_channel_right"
                android:checkable="true"
                style="@style/Widget.Material3.Chip.Filter" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Переключатель типа фильтра -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/peq_filter_type"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filterTypeChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterTypePeaking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/peq_filter_type_peaking"
                    android:checkable="true"
                    style="@style/Widget.Material3.Chip.Filter" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterTypeLowShelf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/peq_filter_type_low_shelf"
                    android:checkable="true"
                    style="@style/Widget.Material3.Chip.Filter" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterTypeHighShelf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/peq_filter_type_high_shelf"
                    android:checkable="true"
                    style="@style/Widget.Material3.Chip.Filter" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterTypeLowPass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/peq_filter_type_low_pass"
                    android:checkable="true"
                    style="@style/Widget.Material3.Chip.Filter" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterTypeHighPass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/peq_filter_type_high_pass"
                    android:checkable="true"
                    style="@style/Widget.Material3.Chip.Filter" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterTypeBandPass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/peq_filter_type_band_pass"
                    android:checkable="true"
                    style="@style/Widget.Material3.Chip.Filter" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterTypeNotch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/peq_filter_type_notch"
                    android:checkable="true"
                    style="@style/Widget.Material3.Chip.Filter" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

    </LinearLayout>

</LinearLayout>
</androidx.core.widget.NestedScrollView>
