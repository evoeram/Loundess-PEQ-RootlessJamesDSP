<?xml version="1.0" encoding="utf-8"?>
<!-- Элемент списка результатов поиска SquigLink с radio-индикатором выбора и статусом загрузки -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:background="@drawable/squig_phone_item_background"
    android:clickable="true"
    android:focusable="true">

    <!-- Radio-индикатор (виден только для выбранного элемента) -->
    <View
        android:id="@+id/radioIndicator"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/squig_radio_indicator"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/brandName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/phoneName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Индикатор статуса загрузки замера -->
    <!-- ✓ (check) — замер загружен в локальную БД -->
    <!-- ✗ (close) — замер ещё не загружен -->
    <ImageView
        android:id="@+id/downloadStatusIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:src="@drawable/squig_download_status_indicator"
        app:tint="?attr/colorOnSurfaceVariant"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>
