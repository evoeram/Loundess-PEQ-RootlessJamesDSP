<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:animateLayoutChanges="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Верхняя строка: инстанс + кнопки ── -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/squig_instance_label"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginEnd="6dp" />

            <Spinner
                android:id="@+id/instanceSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/downloadAllButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:minWidth="36dp"
                android:minHeight="36dp"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/squig_download_all"
                app:icon="@drawable/ic_baseline_download_24dp"
                app:iconSize="20dp"
                app:iconGravity="textTop"
                app:iconPadding="0dp"
                app:strokeWidth="0dp"
                app:cornerRadius="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cacheButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:minWidth="36dp"
                android:minHeight="36dp"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/squig_cache_menu"
                app:icon="@drawable/ic_baseline_cloud_download_24"
                app:iconSize="20dp"
                app:iconGravity="textTop"
                app:iconPadding="0dp"
                app:strokeWidth="0dp"
                app:cornerRadius="18dp" />
        </LinearLayout>

        <!-- ── Строка метаданных каталога ── -->
        <TextView
            android:id="@+id/catalogInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:singleLine="true"
            android:ellipsize="end"
            android:gravity="end" />

        <!-- ── Строка выбора target curve: инстанс таргета + target + импорт ── -->
        <LinearLayout
            android:id="@+id/targetBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/squig_target_label"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginEnd="6dp" />

            <Spinner
                android:id="@+id/targetInstanceSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp" />

            <Spinner
                android:id="@+id/targetSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/importTargetButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:minWidth="36dp"
                android:minHeight="36dp"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/squig_import_target"
                app:icon="@drawable/ic_baseline_upload_file_24"
                app:iconSize="18dp"
                app:iconGravity="textTop"
                app:iconPadding="0dp"
                app:strokeWidth="0dp"
                app:cornerRadius="18dp" />
        </LinearLayout>

        <!-- ── Поле поиска с иконкой ── -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/searchLayout"
            style="?attr/textInputOutlinedDenseStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="6dp"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_search_24dp"
            app:endIconContentDescription="@string/squig_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/squig_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── График АЧХ — главный визуальный элемент (320dp) ── -->
        <me.timschneeberger.rootlessjamesdsp.view.ParametricEqSurface
            android:id="@+id/squigSurface"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="6dp" />

        <!-- ── Статус / прогресс (одна строка) ── -->
        <LinearLayout
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="4dp">

            <ProgressBar
                android:id="@+id/loadingProgress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:singleLine="true"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ── Выбранный телефон (видно после клика на результат) ── -->
        <TextView
            android:id="@+id/selectedPhoneText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorPrimary"
            android:singleLine="true"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- ── Результаты поиска (wrap_content, nestedScroll=false → скроллит внешний NestedScrollView) ── -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/resultsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="4dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <!-- ── Empty state: "Введите запрос для поиска" ── -->
        <TextView
            android:id="@+id/emptyStateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp"
            android:text="@string/squig_empty_state"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:visibility="visible" />

        <!-- ── Кнопки действий: AutoEQ / Live EQ (ряд 1), Reset / Apply (ряд 2) ── -->
        <LinearLayout
            android:id="@+id/actionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp">

            <!-- Ряд 1: AutoEQ + Live EQ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/autoeqButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="@string/squig_autoeq"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:enabled="false"
                    app:icon="@drawable/ic_twotone_auto_fix_high_24"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/liveEqButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/squig_live_eq"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:enabled="false"
                    app:icon="@drawable/ic_baseline_equalizer_24dp"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />
            </LinearLayout>

            <!-- Ряд 2: Reset + Apply -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="@string/squig_reset"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:enabled="false"
                    app:icon="@drawable/ic_baseline_refresh_24dp"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/applyButton"
                    style="?attr/materialButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/squig_apply_to_peq"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:enabled="false"
                    app:icon="@drawable/ic_twotone_check_24dp"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
