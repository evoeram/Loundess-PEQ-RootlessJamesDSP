# SELinux-правила для загрузки libjamesdsp.so в контексте audioserver.
#
# Эти правила нужны KernelSU / SukiSU / APatch, где chcon в service.sh
# может не сработать из-за более строгой SELinux-политики.
# Magisk также применяет этот файл (поддерживается начиная с Magisk 19.x).
#
# audioserver должен иметь возможность читать и запускать библиотеку
# из /vendor/lib/soundfx/ и /vendor/lib64/soundfx/ с контекстом vendor_file.

# Разрешить audioserver читать/исполнять vendor_file (libjamesdsp.so)
allow audioserver vendor_file file { read open execute getattr execute_no_trans map }
allow audioserver vendor_file dir { read open getattr search }

# Разрешить audioserver загружать библиотеку через dlopen
allow audioserver vendor_file:file { read open execute getattr map }
